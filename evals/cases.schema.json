{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eversys Conversations eval case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "segment", "title", "actor", "tenant", "channel", "turns", "fixtures", "expected", "critical", "split"],
  "properties": {
    "id": { "type": "string", "pattern": "^(SEARCH|DATA|CRM|SEC|FAIL|RIO)-[0-9]{3}$" },
    "segment": { "enum": ["search", "current-data", "crm", "security", "failures", "rioplatense"] },
    "title": { "type": "string", "maxLength": 160 },
    "actor": { "enum": ["visitor", "advisor", "manager", "read_only"] },
    "tenant": { "enum": ["bellomo-sintetico", "inmobiliaria-demo-2"] },
    "channel": { "enum": ["web", "whatsapp"] },
    "turns": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["role", "text"], "properties": { "role": { "enum": ["user", "advisor", "system_event"] }, "text": { "type": "string", "maxLength": 2000 } } } },
    "fixtures": { "type": "object" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior", "persisted"],
      "properties": {
        "behavior": { "enum": ["answer", "abstain", "clarify", "handoff", "deny"] },
        "must_include": { "type": "array", "items": { "type": "string" } },
        "must_not_include": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "persisted": {}
      }
    },
    "critical": { "type": "boolean" },
    "split": { "enum": ["dev", "test"] },
    "notes": { "type": "string" }
  }
}
