COMPOSE_PROJECT_NAME=everprop-api
EVERPROP_RESOURCE_PREFIX=everprop-api
EVERPROP_PHP_IMAGE=everprop-api-php:local
HTTP_PORT=18080

APP_NAME=EverProp_API
APP_ENV=local
APP_KEY=CHANGE_ME_APP_KEY
APP_DEBUG=false
APP_URL=http://127.0.0.1:18080
APP_TIMEZONE=UTC

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=everprop-api-mysql
DB_PORT=3306
DB_DATABASE=bellomo_crm
DB_USERNAME=everprop_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_PREFIX=everprop_api_cache
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=everprop-api-redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_QUEUE_CONNECTION=queue
REDIS_PREFIX=everprop_api_

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:18080,localhost:18080,127.0.0.1:3000,localhost:3000,127.0.0.1:5173,localhost:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
TRUSTED_HOSTS=127.0.0.1,localhost
TENANT_HOST_MAP_JSON={}
TENANT_ALLOW_LOCAL_RESOLVER=true
# S02: shared secret with the panel proxy (TENANT_PANEL_SIGNING_KEY there too). The panel signs the host the
# user is on; that host must be a key of TENANT_HOST_MAP_JSON. Empty = signed hosts are rejected.
TENANT_PANEL_SIGNING_KEY=
TENANT_PANEL_SIGNATURE_TTL=60

BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_PER_MINUTE=5
PUBLIC_LEAD_RATE_LIMIT_PER_MINUTE=20
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_MAX_PAYLOAD_BYTES=1048576
WEBHOOK_RETENTION_DAYS=30
WEBHOOK_QUEUE=default
WEBHOOK_SECRET_REF=local/default
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

FILESYSTEM_DISK=local
PRIVATE_FILES_DISK=local
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=auto
AWS_BUCKET=CHANGE_ME_AWS_BUCKET
AWS_ENDPOINT=CHANGE_ME_AWS_ENDPOINT
AWS_URL=CHANGE_ME_AWS_URL
AWS_USE_PATH_STYLE_ENDPOINT=false
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_DEFAULT_REGION=auto
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_URL=
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=log
RESEND_API_KEY=
# Exact frontend origins by tenant slug; recovery stays unavailable until explicitly configured.
PASSWORD_RESET_FRONTENDS_JSON={}
MAIL_FROM_ADDRESS=noreply@example.invalid
MAIL_FROM_NAME=EverProp

# Client collections SMTP: disabled until provisioned and approved; separate from app mail.
COLLECTIONS_MAIL_ENABLED=false
COLLECTIONS_MAIL_TENANT=bellomo
COLLECTIONS_MAIL_FROM_ADDRESS=
COLLECTIONS_MAIL_FROM_NAME="Bellomo Desarrollos"
COLLECTIONS_MAIL_REPLY_TO=
COLLECTIONS_MAIL_SCHEME=smtp
COLLECTIONS_MAIL_HOST=
COLLECTIONS_MAIL_PORT=587
COLLECTIONS_MAIL_USERNAME=
COLLECTIONS_MAIL_PASSWORD=
# EVP-31: approved payment instructions (account/alias/contact). Empty = no collection email is sent.
COLLECTIONS_MAIL_PAYMENT_INSTRUCTIONS=
# Upcoming-installment notice: days before due date, earliest local hour, cap per hourly run.
# Public https logo for collection emails (empty = company name). Bellomo's panel already serves it:
COLLECTIONS_MAIL_LOGO_URL=https://ever-prop-bellomo.vercel.app/brand/bellomo/logo.png
COLLECTIONS_UPCOMING_DAYS=5
COLLECTIONS_UPCOMING_HOUR=9
COLLECTIONS_PAST_DUE_DAYS=3
COLLECTIONS_PAST_DUE_MAX_DAYS=10
COLLECTIONS_MAIL_MAX_PER_RUN=200
# Eversys Conversations (see docs/eversys-conversations). Sending to Meta stays disabled until X04.
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_REDIRECT_URI=
META_INSTAGRAM_ONBOARDING_ENABLED=false
META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0
META_SEND_ENABLED=false
# Optional, text-only sandbox exception: exact phone ID and the same Argentine mobile with/without 9.
META_WHATSAPP_SANDBOX_PHONE_NUMBER_ID=
# Comma-separated inbound wa_ids of approved Argentine sandbox testers; destination is the same number without mobile 9.
META_WHATSAPP_SANDBOX_RECIPIENTS=
META_WHATSAPP_SANDBOX_RECIPIENT_FROM=
META_WHATSAPP_SANDBOX_RECIPIENT_TO=
# Embedded Signup (Tech Provider W4). Public IDs; onboarding stays off until X04 authorizes it.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_ONBOARDING_ENABLED=false

# Assistant (G2). Off until a provider/region is approved (X03). Never commit a real key.
AGENT_LLM_PROVIDER=disabled
# Copilot: drafts for the advisor in control, never sent on their own. Needs a provider.
CONVERSATIONS_COPILOT_ENABLED=false
AGENT_LLM_MODEL=
ANTHROPIC_API_KEY=
# EVP-18: temporary personal OpenAI key, LOCAL ONLY. Never copy to staging/production.
# Select AGENT_LLM_PROVIDER=openai and an explicit Chat Completions-compatible model.
# Keep CONVERSATIONS_AI_ENABLED=false; enable only copilot globally and for the tenant.
OPENAI_API_KEY=
# Required: current USD per million tokens (numerically micro-USD per token), no guessed defaults.
OPENAI_INPUT_MICROS_PER_TOKEN=
OPENAI_OUTPUT_MICROS_PER_TOKEN=
# Required: agreed local monthly AI budget in USD. Empty disables OpenAI.
OPENAI_LOCAL_BUDGET_USD=
# Gemini: personal key for local only; staging requires its own key in the secret manager.
# Select AGENT_LLM_PROVIDER=gemini and an explicit model (e.g. gemini-3.8-flash or gemini-flash-latest).
GEMINI_API_KEY=
GEMINI_INPUT_MICROS_PER_TOKEN=0.075
GEMINI_OUTPUT_MICROS_PER_TOKEN=0.30
GEMINI_LOCAL_BUDGET_USD=10
# EVP-81: default off; also requires Railway's injected RAILWAY_ENVIRONMENT_NAME=staging.
# Never change APP_ENV or override Railway's environment identity to enable Gemini.
GEMINI_STAGING_ENABLED=false
# Optional shared monthly ceiling; overrides GEMINI_LOCAL_BUDGET_USD when supplied.
# GEMINI_BUDGET_USD=10
# Must exceed agent.turn_lock_seconds (180) so a long assistant turn is not redelivered mid-run.
REDIS_QUEUE_RETRY_AFTER=240
