# Public, non-secret browser integration settings.
NEXT_PUBLIC_EVERPROP_API_URL=http://127.0.0.1:18080
NEXT_PUBLIC_EVERPROP_TENANT=bellomo
NEXT_PUBLIC_ENABLE_LOCAL_TENANT_HEADER=true

# Safe default. Use "mock" only in an isolated development/visual-QA build.
NEXT_PUBLIC_DATA_MODE=api

# QA controls are only available in `next dev`, require mock mode, and must be
# opted in explicitly. Never enable them in a deployed environment.
NEXT_PUBLIC_ENABLE_QA_TOOLS=false
