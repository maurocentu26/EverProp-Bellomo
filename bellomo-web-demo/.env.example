# Server-only integration settings. Do not expose these with NEXT_PUBLIC_ prefixes.
EVERPROP_API_URL=http://127.0.0.1:18080
EVERPROP_TENANT=bellomo

# Optional. Without an AI key Bellomito uses the local, deterministic knowledge fallback.
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY is accepted as a backwards-compatible alias.
