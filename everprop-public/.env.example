# Public, non-secret browser integration settings.
NEXT_PUBLIC_EVERPROP_API_URL=http://127.0.0.1:18080
NEXT_PUBLIC_EVERPROP_TENANT=bellomo

# Safe default. Use "mock" only in an isolated development/visual-QA build.
NEXT_PUBLIC_DATA_MODE=api

# Origins allowed to embed the chat widget (space separated), e.g. https://www.bellomo.com.ar
EVERSYS_WIDGET_FRAME_ANCESTORS=

# Public legal pages (/privacidad, /eliminacion-de-datos): privacy contact shown to visitors. Empty = ask in the chat.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# S02: server-only secret shared with the API (same TENANT_PANEL_SIGNING_KEY). Signs the host the user is on so one
# API serves many tenant domains. Never NEXT_PUBLIC_. Empty = the API resolves the tenant by its own host only.
TENANT_PANEL_SIGNING_KEY=
