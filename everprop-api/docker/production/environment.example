# Set these in the deployment service; never commit actual secrets.
APP_NAME=EverProp_API
APP_ENV=production
APP_DEBUG=false
APP_KEY=REPLACE_WITH_EXISTING_PRODUCTION_KEY
APP_URL=https://api.example.com
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_PRIVATE_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=bellomo_crm
DB_USERNAME=REPLACE_WITH_RUNTIME_DML_USER
DB_PASSWORD=REPLACE_WITH_SECRET
REDIS_CLIENT=phpredis
REDIS_HOST=REPLACE_WITH_PRIVATE_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_SECRET
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_QUEUE_CONNECTION=queue
REDIS_PREFIX=everprop_production_
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=redis
CACHE_PREFIX=everprop_production_cache
QUEUE_CONNECTION=redis
SANCTUM_STATEFUL_DOMAINS=app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
TRUSTED_HOSTS=api.example.com,healthcheck.railway.app
TENANT_HOST_MAP_JSON={"api.example.com":"bellomo"}
TENANT_ALLOW_LOCAL_RESOLVER=false
# Exact proxy IPs/CIDRs supplied by the hosting platform. Do not trust arbitrary forwarded hosts.
TRUSTED_PROXIES=
PRIVATE_FILES_DISK=s3
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=REPLACE_WITH_SECRET
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET
AWS_DEFAULT_REGION=auto
AWS_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
AWS_ENDPOINT=https://REPLACE_WITH_STORAGE_ENDPOINT
AWS_USE_PATH_STYLE_ENDPOINT=false
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=EverProp
